# Public site URL, used for canonical and Open Graph links (no trailing slash).
VITE_SITE_URL=

# PLACEHOLDER: SNUG & Co. WhatsApp business number in international format, digits only (e.g. 2547XXXXXXXX).
VITE_WHATSAPP_NUMBER=

# The Flask API's base URL (server/ in this project). Set to /api only when the client
# and API are built and served together from one domain. When the client is deployed on
# its own (e.g. Vercel), use the API's full address instead, e.g.
# https://snug-co-server.onrender.com/api. Leave empty to use the bundled catalog files
# with no backend at all (local preview only).
VITE_API_URL=

# Google Search Console > Add property > HTML tag: paste only the content="..." value.
VITE_GOOGLE_SITE_VERIFICATION=
