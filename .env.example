# Public site URL, used for canonical and Open Graph links (no trailing slash).
VITE_SITE_URL=

# PLACEHOLDER: SNUG & Co. WhatsApp business number in international format, digits only (e.g. 2547XXXXXXXX).
VITE_WHATSAPP_NUMBER=

# The Flask API's base URL. Use /api in production: vercel.json proxies /api to the Render
# API, so the browser only ever talks to this site's own domain (admin cookies stay same-site).
# Leave empty to use the bundled catalog files with no backend at all (local preview only).
VITE_API_URL=

# Google Search Console > Add property > HTML tag: paste only the content="..." value.
VITE_GOOGLE_SITE_VERIFICATION=
