{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://snuggunicorn-wsgi-appco.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://snuggunicorn-wsgi-appco.onrender.com/uploads/:path*" },
    { "source": "/((?!api/|uploads/|images/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
